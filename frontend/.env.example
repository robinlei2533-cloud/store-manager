# ============================================================
# UWELL CRM — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your Supabase credentials
# 
# Get these from: Supabase Dashboard → Project Settings → API

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Preview / production safety switches
# Keep these false when testing real Supabase data externally.
VITE_ALLOW_LOCAL_AUTH_FALLBACK=false
VITE_ALLOW_LOCAL_DB_FALLBACK=false
